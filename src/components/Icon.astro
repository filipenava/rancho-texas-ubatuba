/** Marcas só leem preenchidas; em contorno de 1.5px viram mancha em tamanho pequeno. */
// Instagram fica em contorno: o glifo cheio precisa de winding nonzero para
// manter o ponto da lente, e o resto dos ícones do site usa evenodd.
const brand = ['whatsapp', 'facebook', 'youtube'].includes(name);
const solid = filled || brand;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={solid ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width={solid ? 0 : 1.5}
  fill-rule="evenodd"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}><path d={d}></path></svg
>
