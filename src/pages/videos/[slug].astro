---
import Layout from '../../layouts/Layout.astro';
import Video from '../../components/Video.astro';
import Icon from '../../components/Icon.astro';
import { videos, type VideoName } from '../../data/videos';
import { site } from '../../data/site';
export function getStaticPaths() {
  return (Object.keys(videos) as VideoName[]).map((name) => ({
    params: { slug: videos[name].slug },
    props: { name, clip: videos[name] },
  }));
}
const { name, clip } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: clip.title,
  description: clip.description,
  thumbnailUrl: `${site.url}/videos/${name}-poster-960.webp`,
  contentUrl: `${site.url}/videos/${name}-960.mp4`,
  duration: `PT${Math.round(clip.duration)}S`,
  ...(clip.uploadDate ? { uploadDate: clip.uploadDate } : {}),
  mainEntityOfPage: `${site.url}/videos/${clip.slug}`,
};
---

<Layout
  title={`${clip.title} | Rancho Texas Ubatuba`}
  description={clip.description}
  image={name === 'ubatuba' ? 'praia' : 'fazendinha'}
>
  <article class="watch-page container">
    <a class="text-link" href="/galeria#filmes">← Galeria e filmes</a><span
      class="eyebrow">{clip.label}</span
    ><h1>{clip.title}</h1><Video name={name} auto={false} eager /><div
      class="watch-description"
    >
      <div>
        <h2>Sobre estas cenas</h2><p>{clip.description}</p><p>{clip.context}</p>
      </div><a class="button" href={clip.related}
        >{clip.relatedLabel}<Icon name="arrow" size={18} /></a
      >
    </div>
  </article>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema).replace(/</g, '\u003c')}
  />
</Layout>
