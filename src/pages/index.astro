---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Booking from '../components/Booking.astro';
import RoomCard from '../components/RoomCard.astro';
import CTA from '../components/CTA.astro';
import Video from '../components/Video.astro';
import Amenities from '../components/Amenities.astro';
import Testimonial from '../components/Testimonial.astro';
import Nearby from '../components/Nearby.astro';
import { rooms, faqs, site } from '../data/site';
---

<Layout
  title="Pousada em Ubatuba com piscina e fazendinha | Rancho Texas"
  description="Pousada em Ubatuba com café da manhã incluso, piscina, pesqueiro, fazendinha e camping, a 2 km da Cachoeira do Pé da Serra. Consulte disponibilidade."
  faq
>
  <section class="hero">
    <picture
      ><source
        media="(max-width: 600px)"
        srcset="/images/hero-mobile-480.webp 480w, /images/hero-mobile-800.webp 800w"
        sizes="100vw"
      /><Photo
        name="rancho-lago"
        alt="Pousada Rancho Texas refletida no lago, cercada pela natureza de Ubatuba"
        class="hero-image"
        eager
        sizes="100vw"
      /></picture
    >
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <span class="eyebrow"
        ><span class="little-line"></span> SEU REFÚGIO ENTRE A SERRA E O MAR</span
      ><h1>Desacelere.<br />O melhor da vida<br />acontece <em>aqui.</em></h1><p
      >
        O aconchego do campo, a natureza de Ubatuba<br class="desktop-break" /> e
        tempo de verdade com quem você ama.
      </p><a class="hero-link" href="#o-rancho">Sinta o Rancho <span>↓</span></a
      >
    </div>
    <div class="hero-caption">
      <span class="hero-coordinate">UBATUBA, SÃO PAULO</span><span
        >Natureza por todos os lados. <Icon name="leaf" size={18} /></span
      >
    </div>
  </section>
  <Booking />
  <div class="amenity-strip container">
    <span><Icon name="coffee" /> Café da manhã incluso</span><span
      ><Icon name="water" /> Piscina e pesqueiro</span
    ><span><Icon name="heart" /> Fazendinha com animais</span><span
      ><Icon name="leaf" /> A 2 km da Cachoeira do Pé da Serra</span
    >
  </div>
  <section class="intro-section section container" id="o-rancho">
    <div class="intro-photos intro-photos--film">
      <Video name="fazendinha" /><div class="round-stamp">
        <Icon name="leaf" size={28} /><span
          >MENOS PRESSA<br />MAIS NATUREZA</span
        >
      </div>
    </div><div class="intro-copy">
      <span class="eyebrow">BEM-VINDO AO RANCHO TEXAS</span><h2>
        Um lugar para<br />colecionar <em>memórias.</em>
      </h2><p>
        Tem um outro ritmo esperando por você em Ubatuba. O som dos pássaros, o
        verde pela janela e a alegria de ver as crianças descobrindo o mundo lá
        fora.
      </p><p>
        No Rancho Texas, o jeito simples da vida no campo encontra o aconchego
        de uma pousada. Entre um mergulho e uma visita à fazendinha, sobra
        espaço para o que realmente importa: estar junto.
      </p><a class="text-link" href="/natureza"
        >Conheça nosso cantinho <Icon name="arrow" size={21} /></a
      >
    </div>
  </section>
  <section class="experiences-section section" id="experiencias">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DIAS LEVES, MEMÓRIAS BONITAS</span><h2>
            Viva o Rancho <em>do seu jeito.</em>
          </h2>
        </div><p>
          Para os pequenos, grandes descobertas.<br />Para você, o descanso que
          faz falta.
        </p>
      </div><div class="experience-grid">
        {
          [
            {
              image: 'fazendinha',
              title: 'Pequenos encontros, grandes sorrisos.',
              label: 'NOSSA FAZENDINHA',
              href: '/fazendinha',
            },
            {
              image: 'piscina',
              title: 'O único compromisso é relaxar.',
              label: 'PISCINA & LAZER',
              href: '/natureza',
            },
            {
              image: 'rio',
              title: 'Deixe a natureza fazer parte.',
              label: 'RIO & MATA ATLÂNTICA',
              href: '/natureza',
            },
          ].map((x) => (
            <a class="experience-card" href={x.href}>
              <>
                <Photo
                  name={x.image}
                  sizes="(max-width: 600px) 100vw, 33vw"
                  alt={
                    x.label === 'NOSSA FAZENDINHA'
                      ? 'Contato com os animais da fazendinha'
                      : x.label === 'PISCINA & LAZER'
                        ? 'Piscina rodeada de vegetação'
                        : 'Águas do rio em meio à Mata Atlântica'
                  }
                />
                <div>
                  <>
                    <span class="eyebrow">{x.label}</span>
                    <h3>{x.title}</h3>
                    <span class="circle-arrow">
                      <Icon name="arrow" />
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <Amenities />
  <section class="rooms-section section container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">ACONCHEGO DEPOIS DE UM DIA LÁ FORA</span><h2>
          Seu descanso <em>tem lugar.</em>
        </h2>
      </div><a href="/acomodacoes" class="text-link"
        >Todas as acomodações <Icon name="arrow" size={20} /></a
      >
    </div><div class="room-grid">
      {rooms.slice(0, 3).map((room) => <RoomCard room={room} />)}
    </div>
  </section>
  <Testimonial />
  <section class="camping-section">
    <Photo
      name="camping"
      alt="Barraca em área verde do camping Rancho Texas Ubatuba"
    /><div class="camping-copy">
      <span class="eyebrow">PARA QUEM GOSTA DE ESTAR MAIS PERTO</span><h2>
        O céu como teto.<br />A natureza como <em>companhia.</em>
      </h2><p>
        Monte sua barraca, respire fundo e troque a rotina por dias ao ar livre.
        Nosso camping é um convite para viver Ubatuba com simplicidade.
      </p><a href="/camping" class="button button-light"
        >Descubra nosso camping <Icon name="arrow" size={19} /></a
      >
    </div>
  </section>
  <Nearby />
  <section class="local-section">
    <div class="local-copy">
      <span class="eyebrow">CAMPO, SERRA E MAR</span><h2>
        Um outro jeito<br />de viver <em>Ubatuba.</em>
      </h2><p>
        O Rancho fica no Horto Florestal, na entrada de Ubatuba para quem chega
        pela serra. Um ponto de partida para descobrir a Mata Atlântica, chegar
        à Cachoeira do Pé da Serra em poucos minutos e incluir as praias no
        roteiro.
      </p><div class="address-note">
        <Icon name="pin" size={20} /><span
          >Rodovia Oswaldo Cruz, km 88,9<br />Horto Florestal · Ubatuba, SP</span
        >
      </div><div class="local-links">
        <a href="/contato" class="button button-light"
          >Veja como chegar <Icon name="arrow" size={19} /></a
        ><a class="local-film-link" href="/videos/paisagens-de-ubatuba"
          >A história do filme <Icon name="arrow" size={17} /></a
        >
      </div>
    </div><div class="local-film">
      <Video name="ubatuba" fill />
    </div>
  </section>
  <section class="faq-section section">
    <div class="container faq-layout">
      <div>
        <span class="eyebrow">ANTES DE ARRUMAR AS MALAS</span><h2>
          Vamos tirar<br />suas <em>dúvidas?</em>
        </h2><p>Uma boa viagem começa com tranquilidade.</p><a
          href={site.whatsapp}
          class="text-link"
          target="_blank"
          rel="noopener noreferrer"
          >Converse com a gente <Icon name="arrow" size={20} /></a
        >
      </div><div class="faq-list" id="duvidas">
        {
          faqs.map((f) => (
            <details>
              <>
                <summary>
                  {f.question}
                  <span aria-hidden="true">+</span>
                </summary>
                <p>{f.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <CTA />
</Layout>
